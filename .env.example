# hkquant-gallery 环境变量模板（复制为 .env 并填写；.env 严禁入库）
# 管理员初始密码（仅首次初始化 auth.json 时生效；之后经管理页修改）
GALLERY_ADMIN_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
# 站点标题
GALLERY_TITLE=HKQuant Gallery
# FTP 根目录（容器内路径，compose 已只读挂载宿主 /srv/ftp）
GALLERY_FTP_ROOT=/srv/ftp
# JSON 数据目录（compose 挂载宿主 /opt/hkquant-gallery/data）
GALLERY_DATA_DIR=/data
# 本地 http 调试时设为 0（生产必须保留 1：Cookie 带 Secure）
# GALLERY_COOKIE_SECURE=1
# FTP 存储配额（字节），仅用于管理页容量显示，须与主机 setquota 一致；默认 10G
# GALLERY_QUOTA_BYTES=10737418240
# 人脸检索（模型目录 compose 已挂载 /models 只读；以下均有默认值）
# GALLERY_FACES_DIR=/models
# GALLERY_FACES_THRESHOLD=0.40        # 余弦相似度匹配阈值
# GALLERY_FACES_INDEX_INTERVAL=1.5    # 后台索引每张图节流秒数
# GALLERY_FACES_IDLE_UNLOAD=300       # 闲置卸载秒数（0＝常驻）
# GALLERY_FACES_MAX_UPLOAD=8388608    # 自拍上传上限（字节）
